// =================================================================
// UTILITIES
// =================================================================
function seedDemoData() {
  const services = ['DALIL', 'DAWWIN', 'WBS', 'Audit', 'Compliance'];
  const sens = ['internal', 'confidential', 'restricted', 'public'];
  const users = ['sopian.hadianto@bpkh.go.id', 'auditor.junior@bpkh.go.id', 'dewas1@bpkh.go.id', 'invest1@bpkh.go.id'];
  auditLog = [];
  for (let i = 0; i < 60; i++) {
    const d = new Date(Date.now() - i * 0.4 * 3600 * 1000);
    auditLog.push({ time: d.toLocaleTimeString('id-ID', { hour12: false }), timestamp: d.getTime(), service: services[Math.floor(Math.random() * services.length)], user: users[Math.floor(Math.random() * users.length)], sensitivity: sens[Math.floor(Math.random() * sens.length)], routed: 'ollama-local', tokens: 500 + Math.floor(Math.random() * 2500), hash: randHash() });
  }
  localStorage.setItem('moni_audit_log', JSON.stringify(auditLog));
  renderAuditLog();
  renderAuditCharts();
  alert('60 demo audit log entries seeded · 24h history simulated');
}

function clearAuditLog() {
  if (!confirm('Hapus seluruh audit log?')) return;
  auditLog = [];
  localStorage.removeItem('moni_audit_log');
  renderAuditLog();
}

function exportAudit() {
  const blob = new Blob([JSON.stringify(auditLog, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `bpkh_audit_${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
}

function globalSearch() {
  const q = document.getElementById('global-search').value.trim();
  if (!q) return;
  document.getElementById('dalil-query').value = q;
  showPage('dalil');
  runDalilSearch();
}

// =================================================================
// INIT
// =================================================================
window.addEventListener('DOMContentLoaded', () => {
  if (!currentRole) openRoleModal();
  else applyRole();
  updateNotifDot();
  document.getElementById('today-inferences').textContent = userActivity.length;
  document.getElementById('week-inferences').textContent = userActivity.length;
});
</script>
</body>
</html>
