// =================================================================
// STATE
// =================================================================
let currentRole = localStorage.getItem('moni_role') || null;
let currentFilter = 'all';
let auditLog = JSON.parse(localStorage.getItem('moni_audit_log') || '[]');
let savedSearches = JSON.parse(localStorage.getItem('moni_saved_searches') || '[]');
let drafts = JSON.parse(localStorage.getItem('moni_drafts') || '[]');
let userActivity = JSON.parse(localStorage.getItem('moni_user_activity') || '[]');
let notifications = [...NOTIFICATIONS];
let chartsRendered = {};

// =================================================================
// ROLE MANAGEMENT
// =================================================================
function openRoleModal() { document.getElementById('role-modal').classList.add('active'); }
function closeRoleModal() { document.getElementById('role-modal').classList.remove('active'); }

function selectRole(roleKey) {
  currentRole = roleKey;
  localStorage.setItem('moni_role', roleKey);
  closeRoleModal();
  applyRole();
}

function applyRole() {
  if (!currentRole) { openRoleModal(); return; }
  const role = ROLES[currentRole];
  if (!role) { openRoleModal(); return; }

  document.getElementById('active-role-name').textContent = role.name;
  document.getElementById('active-role-org').textContent = role.org;
  document.getElementById('user-fullname').textContent = role.user;
  document.getElementById('user-email').textContent = role.email;
  document.getElementById('user-avatar').textContent = role.initials;
  document.getElementById('dash-eyebrow').textContent = `⌗ ${role.org.toUpperCase()}`;
  document.getElementById('dash-title').textContent = `Selamat datang, ${role.user.split(' ')[0]}`;

  // Render navigation
  const navMenu = document.getElementById('nav-menu');
  navMenu.innerHTML = role.nav.map(section => `
    <div class="nav-section">
      <div class="nav-section-title">${section.section}</div>
      ${section.items.map(item => `
        <div class="nav-item ${item.id === 'dashboard' ? 'active' : ''}" data-page="${item.id}" onclick="showPage('${item.id}', this)">
          <span class="nav-icon">${item.icon}</span>
          <span>${item.label}</span>
          ${item.badge ? `<span class="nav-badge">${item.badge}</span>` : ''}
        </div>
      `).join('')}
    </div>
  `).join('');

  // Render quick actions
  const qa = document.getElementById('quick-actions');
  qa.innerHTML = role.quickActions.map(a => `
    <div class="qa-card" onclick="showPage('${a.id}')">
      <div class="qa-icon">${a.icon}</div>
      <div class="qa-title">${a.title}</div>
      <div class="qa-desc">${a.desc}</div>
    </div>
  `).join('');

  // Render dashboard stats
  renderDashboardStats();
  renderRecentActivity();
  showPage('dashboard');
}

