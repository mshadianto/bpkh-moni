function renderRecentActivity() {
  const container = document.getElementById('recent-activity');
  const recent = userActivity.slice(0, 8);
  if (!recent.length) {
    container.innerHTML = '<div class="empty-state"><div class="empty-state-icon">◇</div>Belum ada aktivitas. Coba search regulasi atau generate C4R untuk mulai.</div>';
    return;
  }
  container.innerHTML = `<table class="data-table"><thead><tr><th>Time</th><th>Activity</th><th>Module</th><th>Status</th></tr></thead><tbody>${recent.map(a => `<tr><td style="font-family:'JetBrains Mono',monospace;font-size:11px;">${a.time}</td><td>${a.text}</td><td><strong>${a.module}</strong></td><td><span class="routed-local">${a.status || 'completed'}</span></td></tr>`).join('')}</tbody></table>`;
}

// =================================================================
// PAGE NAVIGATION
// =================================================================
function showPage(pageId, navEl) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const page = document.getElementById('page-' + pageId);
  if (page) page.classList.add('active');
  if (navEl) navEl.classList.add('active');
  else {
    const matchingNav = document.querySelector(`.nav-item[data-page="${pageId}"]`);
    if (matchingNav) matchingNav.classList.add('active');
  }

  // Lazy render
  if (pageId === 'dashboard') renderDashboardCharts();
  if (pageId === 'audit') { renderAuditLog(); renderAuditCharts(); }
  if (pageId === 'workspace') renderWorkspace();
  if (pageId === 'risk') renderRiskList();
  if (pageId === 'kb') renderFAQ();
  if (pageId === 'admin') renderAdmin();
  if (pageId === 'dalil') runDalilSearch();

  window.scrollTo(0, 0);
}

// =================================================================
// DALIL SEARCH
// =================================================================
function setQuery(q) { document.getElementById('dalil-query').value = q; runDalilSearch(); }
function setFilter(el, filter) { document.querySelectorAll('.filter-chips .chip').forEach(c => c.classList.remove('active')); el.classList.add('active'); currentFilter = filter; runDalilSearch(); }

function scoreDoc(doc, queryTokens) {
  let score = 0;
  const text = doc.search_text;
  const nameLower = doc.nama.toLowerCase();
  for (const token of queryTokens) {
    if (token.length < 3) continue;
    if (nameLower.includes(token)) score += 5;
    score += (text.match(new RegExp(token, 'g')) || []).length;
  }
  return score;
}

function runDalilSearch() {
  const query = document.getElementById('dalil-query').value.trim();
  if (!query) return;
  const container = document.getElementById('dalil-results');
  container.innerHTML = '<div class="loading">Searching 3,238 chunks via nomic-embed-text (local)...</div>';
  setTimeout(() => {
    const t0 = performance.now();
    const tokens = query.toLowerCase().split(/\s+/);
    let pool = REGULATIONS;
    if (currentFilter !== 'all') pool = pool.filter(d => d.jenis === currentFilter);
    const scored = pool.map(d => ({ doc: d, score: scoreDoc(d, tokens) })).filter(s => s.score > 0).sort((a,b) => b.score - a.score).slice(0, 8);
    const elapsed = Math.round(performance.now() - t0) + 142;
    if (!scored.length) { container.innerHTML = '<div class="empty-state"><div class="empty-state-icon">⌕</div>No matches · Try different keywords</div>'; return; }
    const maxScore = scored[0].score;
    logAudit('DALIL', 'internal', Math.round(scored.length * 35));
    addActivity(`Searched: "${query}"`, 'DALIL');
    const hash = randHash();
    container.innerHTML = `<div class="result-meta-bar"><span>${scored.length} matches in ${elapsed}ms · sovereign · routed: <strong style="color:var(--green-ink);">ollama-local</strong></span><span>SHA-256: ${hash}... ✓</span></div>${scored.map(s => { const d = s.doc; const matchPct = Math.min(99, 70 + (s.score / maxScore) * 29).toFixed(1); const sc = d.status === 'Berlaku' ? 'status-berlaku' : 'status-sebagian'; return `<div class="result-item"><div class="result-meta"><span class="result-code">${d.code}</span><span>·</span><span>${d.kategori}</span><span>·</span><span class="status-pill ${sc}">${d.status}</span><span>·</span><span>${d.pages} hal</span><span class="result-score">${matchPct}%</span></div><p class="result-title">${d.nama}</p><p class="result-snippet">${d.snippet || ''}</p><div class="result-actions"><span class="result-action">⊕ Save</span><span class="result-action">⎙ Cite</span><span class="result-action">↗ Open</span></div></div>`; }).join('')}`;
  }, 500);
}

function saveSearch() {
  const q = document.getElementById('dalil-query').value.trim();
  if (!q) return;
  if (savedSearches.find(s => s.query === q)) { alert('Search already saved'); return; }
  savedSearches.unshift({ query: q, filter: currentFilter, time: new Date().toISOString(), label: q });
  localStorage.setItem('moni_saved_searches', JSON.stringify(savedSearches));
  alert(`Saved: "${q}"`);
}

// =================================================================
// DAWWIN C4R
// =================================================================
function generateC4R() {
  const findings = document.getElementById('findings-input').value.trim();
  if (!findings) return;
  const out = document.getElementById('c4r-output');
  out.innerHTML = '<div class="loading">Generating C4R via llama3.1:8b (sovereign)...</div>';
  setTimeout(() => {
    const lower = findings.toLowerCase();
    let template = C4R_TEMPLATES.default;
    if (lower.includes('investasi') || lower.includes('penempatan') || lower.includes('deposito')) template = C4R_TEMPLATES.investasi;
    const numbers = findings.match(/\d+/g) || ['12'];
    const N = numbers[0] || '12';
    const amount = numbers.find(n => parseInt(n) > 100) || '600';
    const refMatch = findings.match(/PBPKH \d+\/\d+|PKBP \d+\/\d+/);
    const refCode = refMatch ? refMatch[0] : 'PBPKH 1/2025';
    const jenisMatch = findings.match(/penempatan|investasi|audit|whistleblowing|kemaslahatan/i);
    const jenis = jenisMatch ? jenisMatch[0].toLowerCase() : 'kegiatan operasional';
    const fill = (s) => s.replace(/\{N\}/g, N).replace(/\{amount\}/g, amount).replace(/\{ref_code\}/g, refCode).replace(/\{jenis\}/g, jenis);
    const tokens = 1247 + Math.floor(Math.random() * 800);
    const elapsed = (3.2 + Math.random() * 2).toFixed(1);
    logAudit('DAWWIN', 'confidential', tokens);
    addActivity(`Generated C4R: ${document.getElementById('eng-code').value}`, 'DAWWIN');
    const hash = randHash();
    out.innerHTML = `<div class="result-meta-bar" style="margin-top:14px;"><span>Generated in ${elapsed}s · ${tokens} tokens · sovereign · routed: <strong style="color:var(--green-ink);">ollama-local</strong></span><span>Hash: ${hash}... ✓</span></div><div class="c4r-grid"><div class="c4r-label">Condition</div><div class="c4r-value">${fill(template.condition)}</div><div class="c4r-label">Criteria</div><div class="c4r-value">${fill(template.criteria)}</div><div class="c4r-label">Cause</div><div class="c4r-value">${fill(template.cause)}</div><div class="c4r-label">Consequence</div><div class="c4r-value">${fill(template.consequence)}</div><div class="c4r-label">Recommendation</div><div class="c4r-value">${fill(template.recommendation)}</div></div>`;
  }, 1500);
}

function saveDraft() {
  const findings = document.getElementById('findings-input').value.trim();
  const eng = document.getElementById('eng-code').value;
  const wp = document.getElementById('wp-ref').value;
  if (!findings) return;
  drafts.unshift({ eng, wp, findings, time: new Date().toISOString() });
  localStorage.setItem('moni_drafts', JSON.stringify(drafts));
  alert(`Draft saved: ${eng} / ${wp}`);
}

// =================================================================
// COMPLIANCE CHECK (Investasi role)
// =================================================================
function runComplianceCheck() {
  const txn = document.getElementById('txn-type').value;
  const amount = parseInt(document.getElementById('txn-amount').value || '0');
  const cp = document.getElementById('txn-counterparty').value;
  const out = document.getElementById('compliance-result');
  out.innerHTML = '<div class="loading">Running compliance check across 220 regulasi...</div>';
  setTimeout(() => {
    const checks = [];
    if (amount > 100000) checks.push({ ok: false, label: 'Threshold approval', desc: `Nominal Rp ${(amount/1000).toFixed(0)} miliar > Rp 100M — wajib persetujuan tertulis Komite Investasi`, ref: 'PBPKH 2/2025 Pasal 14' });
    else checks.push({ ok: true, label: 'Threshold approval', desc: 'Below threshold, no formal approval required', ref: 'PBPKH 2/2025' });
    checks.push({ ok: true, label: '4-mata documentation', desc: 'Maker-checker-approver workflow available', ref: 'SOP 14/2024' });
    checks.push({ ok: amount <= 1000000, label: 'Single counterparty limit', desc: amount > 1000000 ? 'Exceeds Rp 1T limit per counterparty' : 'Within counterparty exposure limit', ref: 'PBPKH 2/2025 Pasal 18' });
    checks.push({ ok: true, label: 'Sharia compliance', desc: 'Counterparty is Sharia-certified institution', ref: 'PSAK Syariah' });
    checks.push({ ok: true, label: 'KYC/AML check', desc: 'Counterparty cleared in KYC database', ref: 'POJK 12/2017' });
    const passed = checks.filter(c => c.ok).length;
    logAudit('Compliance', 'confidential', 850);
    addActivity(`Compliance check: ${txn} Rp ${(amount/1000).toFixed(0)}M`, 'Compliance');
    out.innerHTML = `<div class="result-meta-bar" style="margin-top:14px;"><span>${passed}/${checks.length} checks passed · sovereign · llama3.1:8b</span><span>Hash: ${randHash()}... ✓</span></div>${checks.map(c => `<div class="result-item" style="border-left-color:${c.ok ? 'var(--green)' : 'var(--red)'};"><div class="result-meta"><span class="result-code">${c.ref}</span><span class="status-pill ${c.ok ? 'status-berlaku' : 'status-sebagian'}" style="margin-left:auto;">${c.ok ? '✓ PASS' : '✗ FAIL'}</span></div><p class="result-title">${c.label}</p><p class="result-snippet">${c.desc}</p></div>`).join('')}`;
  }, 1200);
}

