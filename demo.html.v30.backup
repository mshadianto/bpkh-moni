// =================================================================
// AUDIT LOG
// =================================================================
function logAudit(service, sensitivity, tokens) {
  const entry = { time: new Date().toLocaleTimeString('id-ID', { hour12: false }), timestamp: Date.now(), service, user: ROLES[currentRole]?.email || 'unknown', sensitivity, routed: 'ollama-local', tokens, hash: randHash() };
  auditLog.unshift(entry);
  if (auditLog.length > 100) auditLog = auditLog.slice(0, 100);
  localStorage.setItem('moni_audit_log', JSON.stringify(auditLog));
}

function addActivity(text, module) {
  userActivity.unshift({ time: new Date().toLocaleTimeString('id-ID', { hour12: false }), text, module, status: 'completed' });
  if (userActivity.length > 50) userActivity = userActivity.slice(0, 50);
  localStorage.setItem('moni_user_activity', JSON.stringify(userActivity));
  document.getElementById('today-inferences').textContent = userActivity.length;
  document.getElementById('week-inferences').textContent = userActivity.length;
}

function randHash() { return Math.random().toString(16).slice(2, 10); }

function renderAuditLog() {
  const wrap = document.getElementById('audit-table-wrap');
  if (!auditLog.length) { wrap.innerHTML = '<div class="empty-state"><div class="empty-state-icon">◐</div>Belum ada audit entries · Click "⚡ Seed" untuk populate demo data</div>'; return; }
  wrap.innerHTML = `<table class="data-table"><thead><tr><th>Time</th><th>Service</th><th>User</th><th>Sensitivity</th><th>Routed</th><th>Tokens</th><th>Hash</th></tr></thead><tbody>${auditLog.slice(0, 25).map(e => `<tr><td style="font-family:'JetBrains Mono',monospace;font-size:11px;">${e.time}</td><td><strong>${e.service}</strong></td><td style="font-family:'JetBrains Mono',monospace;font-size:11px;">${e.user}</td><td><span class="sens-pill sens-${e.sensitivity}">${e.sensitivity}</span></td><td><span class="routed-local">${e.routed}</span></td><td style="font-family:'JetBrains Mono',monospace;font-size:11px;">${e.tokens.toLocaleString('id-ID')}</td><td style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-muted);">${e.hash}...</td></tr>`).join('')}</tbody></table>`;
}

function renderAuditCharts() {
  const ctx1 = document.getElementById('chart-sovereignty');
  if (ctx1._chart) ctx1._chart.destroy();
  const hours = Array.from({length: 24}, (_, i) => `${(23-i)}h`).reverse();
  ctx1._chart = new Chart(ctx1, { type: 'line', data: { labels: hours, datasets: [{ label: 'Local', data: hours.map(() => Math.floor(80 + Math.random() * 60)), borderColor: '#16A34A', backgroundColor: 'rgba(22,163,74,0.1)', fill: true, tension: 0.3, borderWidth: 2 },{ label: 'Cloud', data: hours.map(() => 0), borderColor: '#EF4444', backgroundColor: 'rgba(239,68,68,0.1)', fill: true, tension: 0.3, borderWidth: 2 }]}, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { family: 'Manrope', size: 11 } } } }, scales: { x: { ticks: { font: { size: 9 }, maxTicksLimit: 8 } }, y: { beginAtZero: true } } } });

  const ctx2 = document.getElementById('chart-services');
  if (ctx2._chart) ctx2._chart.destroy();
  const svcCount = { DALIL: 0, DAWWIN: 0, WBS: 0, Audit: 0, Compliance: 0 };
  auditLog.forEach(e => { if (svcCount[e.service] !== undefined) svcCount[e.service]++; });
  ctx2._chart = new Chart(ctx2, { type: 'doughnut', data: { labels: Object.keys(svcCount), datasets: [{ data: Object.values(svcCount), backgroundColor: ['#0A2540', '#D4AF37', '#1E5A8A', '#854D0E', '#16A34A'], borderWidth: 0 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right', labels: { font: { family: 'Manrope', size: 11 }, padding: 12 } } } } });
}

function renderDashboardCharts() {
  const ctx = document.getElementById('chart-activity');
  if (!ctx || ctx._chart) return;
  ctx._chart = new Chart(ctx, { type: 'bar', data: { labels: ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'], datasets: [{ label: 'DALIL', data: [12, 18, 15, 22, 19, 4, 2], backgroundColor: '#0A2540' },{ label: 'DAWWIN', data: [3, 5, 4, 7, 6, 1, 0], backgroundColor: '#D4AF37' },{ label: 'Compliance', data: [8, 12, 10, 14, 11, 2, 1], backgroundColor: '#1E5A8A' }]}, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { family: 'Manrope', size: 11 } } } }, scales: { y: { beginAtZero: true, stacked: true }, x: { stacked: true } } } });
}

