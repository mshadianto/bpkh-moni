const C4R_TEMPLATES = {
  'investasi': {
    condition: "Ditemukan {N} transaksi penempatan dana haji {jenis} senilai Rp {amount} miliar pada periode audit yang menunjukkan ketidaksesuaian dengan governance framework BPKH terkait persetujuan formal sebelum eksekusi.",
    criteria: "Berdasarkan {ref_code} dan SOP terkait penempatan dana haji, setiap transaksi di atas threshold Rp 100 miliar wajib mendapatkan: (1) persetujuan tertulis dari Komite Investasi sebelum eksekusi, (2) kajian risiko independen, (3) dokumentasi 4-mata sesuai prinsip control internal.",
    cause: "Akar masalah: (1) tekanan timeline penempatan akhir periode investasi, (2) workflow approval belum terintegrasi sistem treasury, (3) kekosongan posisi key approver tanpa backup mechanism formal.",
    consequence: "Risiko langsung: pelanggaran governance Rp {amount} miliar, potensi temuan auditor eksternal. Risiko lanjutan: state financial loss kalau placement underperform, eksposur reputational, sanksi administratif Dewas.",
    recommendation: "(1) Implementasi system block: enforcement otomatis cegah eksekusi > Rp 100M tanpa digital signature 3 anggota Komite Investasi · (2) Backup approval mechanism dengan delegation matrix · (3) Quarterly reconciliation oleh internal audit · (4) Post-fact ratification untuk transaksi berjalan, timeline 30 hari."
  },
  'default': {
    condition: "Hasil pemeriksaan menunjukkan {N} kejadian yang menyimpang dari ketentuan internal BPKH terkait {jenis} pada periode audit, dengan dampak agregat material terhadap governance posture.",
    criteria: "Berdasarkan {ref_code}, setiap proses {jenis} wajib mengikuti: (1) standard prosedur operasional terdokumentasi, (2) audit trail lengkap, (3) kontrol berlapis sesuai prinsip 3 Lines of Defense.",
    cause: "Akar masalah: (1) gap dalam internal control framework, (2) ketidakcukupan training awareness, (3) tools belum support enforcement otomatis kebijakan.",
    consequence: "Dampak: kepatuhan UU 34/2014 berisiko, potensi temuan auditor, eksposur reputational BPKH, potensi sanksi dari Dewas/Kemenag/Kemenkeu.",
    recommendation: "(1) Strengthening internal control dengan automated checks · (2) Training program comprehensive · (3) Enhanced monitoring quarterly oleh internal audit · (4) Remediation plan untuk kasus existing dengan accountability owner."
  }
};

