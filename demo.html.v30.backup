      { label: 'Pending tasks', value: '8', delta: '3 high priority' },
      { label: 'This week txn', value: '47', delta: '100% compliant' },
      { label: 'Threshold breaches', value: '0', delta: 'Q1 clean record' },
      { label: 'Avg approval time', value: '2.4h', delta: '-15min vs target' },
    ],
    'auditor': [
