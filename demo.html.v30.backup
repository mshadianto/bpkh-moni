<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MONI · BPKH Sovereign AI Platform v3.1 · Internal</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
  :root {
    --navy-900: #0A2540; --navy-800: #103A5C; --navy-700: #1E5A8A; --navy-600: #2C6CA0;
    --gold-500: #D4AF37; --gold-400: #E5C457; --gold-100: #F4E4BC; --gold-50: #FBF7EE;
    --cream: #FBF7EE; --ink: #1A1F2E; --ink-soft: #4A5568; --ink-muted: #718096; --ink-subtle: #A0AEC0;
    --line: rgba(10, 37, 64, 0.08); --line-strong: rgba(10, 37, 64, 0.18);
    --bg: #F7F5F0; --surface: #FFFFFF; --surface-2: #FAF8F3; --surface-3: #F1EDE3;
    --green: #16A34A; --green-bg: #DCFCE7; --green-ink: #166534;
    --amber: #D97706; --amber-bg: #FEF3C7; --amber-ink: #854D0E;
    --orange-bg: #FED7AA; --orange-ink: #9A3412;
    --red: #DC2626; --red-bg: #FECACA; --red-ink: #991B1B;
    --blue-bg: #DBEAFE; --blue-ink: #1E40AF;
    --purple-bg: #EDE9FE; --purple-ink: #5B21B6;
    --teal-bg: #CCFBF1; --teal-ink: #115E59;
    --pink-bg: #FCE7F3; --pink-ink: #9F1239;
    --shadow-sm: 0 1px 2px rgba(10, 37, 64, 0.04);
    --shadow-md: 0 4px 12px rgba(10, 37, 64, 0.06);
    --shadow-lg: 0 10px 30px rgba(10, 37, 64, 0.10);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body { font-family: 'Manrope', sans-serif; background: var(--bg); color: var(--ink); line-height: 1.55; font-size: 14px; min-height: 100vh; }

  /* === LAYOUT === */
  .app-layout { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
  .sidebar { background: var(--navy-900); color: var(--gold-100); padding: 0; position: sticky; top: 0; height: 100vh; overflow-y: auto; border-right: 0.5px solid rgba(212, 175, 55, 0.15); }
  .main-area { background: var(--bg); min-height: 100vh; overflow-x: hidden; }

  /* === SIDEBAR === */
  .sidebar-brand { padding: 22px 22px 18px; border-bottom: 0.5px solid rgba(212, 175, 55, 0.15); }
  .brand-crest { font-family: 'Fraunces', serif; font-size: 9px; letter-spacing: 0.3em; color: var(--gold-500); margin-bottom: 4px; font-weight: 500; }
  .brand-name { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 500; color: var(--gold-100); letter-spacing: -0.01em; }
  .brand-sub { font-size: 10px; color: rgba(244, 228, 188, 0.55); letter-spacing: 0.05em; text-transform: uppercase; margin-top: 2px; }

  .role-switcher { padding: 14px 18px; background: rgba(212, 175, 55, 0.05); border-bottom: 0.5px solid rgba(212, 175, 55, 0.1); cursor: pointer; transition: background 0.15s; }
  .role-switcher:hover { background: rgba(212, 175, 55, 0.1); }
  .role-label { font-size: 9px; color: rgba(244, 228, 188, 0.5); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px; font-weight: 500; }
  .role-name { font-size: 13px; font-weight: 600; color: var(--gold-100); display: flex; align-items: center; gap: 8px; }
  .role-name-arrow { margin-left: auto; color: var(--gold-500); font-size: 10px; }
  .role-org { font-size: 11px; color: rgba(244, 228, 188, 0.6); margin-top: 2px; }

  .nav-section { padding: 14px 0 8px; }
  .nav-section-title { font-size: 9px; color: rgba(244, 228, 188, 0.4); letter-spacing: 0.15em; text-transform: uppercase; padding: 0 22px; margin-bottom: 8px; font-weight: 600; font-family: 'JetBrains Mono', monospace; }
  .nav-item { padding: 9px 22px; font-size: 13px; color: rgba(244, 228, 188, 0.75); cursor: pointer; transition: all 0.15s; display: flex; align-items: center; gap: 12px; border-left: 2px solid transparent; }
  .nav-item:hover { background: rgba(212, 175, 55, 0.08); color: var(--gold-100); border-left-color: rgba(212, 175, 55, 0.3); }
  .nav-item.active { background: rgba(212, 175, 55, 0.12); color: var(--gold-100); border-left-color: var(--gold-500); font-weight: 600; }
  .nav-icon { font-family: 'Fraunces', serif; font-size: 14px; color: var(--gold-500); flex-shrink: 0; width: 16px; }
  .nav-badge { margin-left: auto; font-size: 9px; padding: 2px 7px; border-radius: 10px; background: var(--gold-500); color: var(--navy-900); font-weight: 700; font-family: 'JetBrains Mono', monospace; }

  .sidebar-footer { padding: 18px 22px; border-top: 0.5px solid rgba(212, 175, 55, 0.15); margin-top: 24px; }
  .user-card { display: flex; align-items: center; gap: 10px; padding: 10px; background: rgba(212, 175, 55, 0.06); border-radius: 10px; cursor: pointer; transition: background 0.15s; }
  .user-card:hover { background: rgba(212, 175, 55, 0.1); }
  .user-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--gold-500); color: var(--navy-900); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; font-family: 'Fraunces', serif; flex-shrink: 0; }
  .user-info { flex: 1; overflow: hidden; }
  .user-name { font-size: 12px; font-weight: 600; color: var(--gold-100); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .user-email { font-size: 10px; color: rgba(244, 228, 188, 0.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: 'JetBrains Mono', monospace; }

  /* === TOP BAR === */
  .topbar { background: var(--surface); border-bottom: 0.5px solid var(--line); padding: 12px 28px; display: flex; align-items: center; gap: 16px; position: sticky; top: 0; z-index: 50; backdrop-filter: blur(8px); background: rgba(255, 255, 255, 0.92); }
  .topbar-search { flex: 1; max-width: 480px; position: relative; }
  .topbar-search input { width: 100%; padding: 9px 14px 9px 38px; border: 0.5px solid var(--line-strong); border-radius: 10px; font-size: 13px; font-family: inherit; background: var(--surface-2); color: var(--ink); }
  .topbar-search input:focus { outline: none; border-color: var(--gold-500); background: var(--surface); box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1); }
  .topbar-search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-family: 'Fraunces', serif; font-size: 14px; color: var(--ink-muted); }
  .topbar-actions { display: flex; gap: 8px; align-items: center; margin-left: auto; }
  .topbar-btn { background: transparent; border: 0.5px solid var(--line); padding: 7px 12px; border-radius: 8px; font-size: 12px; cursor: pointer; color: var(--ink-soft); font-family: inherit; font-weight: 500; transition: all 0.15s; display: inline-flex; align-items: center; gap: 6px; }
  .topbar-btn:hover { background: var(--surface-2); border-color: var(--line-strong); color: var(--ink); }
  .topbar-btn.primary { background: var(--navy-900); color: var(--gold-100); border-color: var(--navy-900); }
  .topbar-btn.primary:hover { background: var(--navy-800); }
  .notif-bell { position: relative; padding: 7px 10px; }
  .notif-dot { position: absolute; top: 4px; right: 6px; width: 7px; height: 7px; background: var(--red); border-radius: 50%; border: 1.5px solid var(--surface); }

  /* === CONTENT === */
  .content-wrap { padding: 24px 28px 60px; max-width: 1280px; margin: 0 auto; }
  .page { display: none; }
  .page.active { display: block; animation: fadeIn 0.25s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

  /* === PAGE HEADER === */
  .page-header { margin-bottom: 24px; }
  .page-eyebrow { font-family: 'Fraunces', serif; font-size: 10px; letter-spacing: 0.25em; color: var(--gold-500); text-transform: uppercase; margin-bottom: 6px; font-weight: 500; }
  .page-title { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 500; color: var(--ink); margin: 0; letter-spacing: -0.02em; }
  .page-sub { font-size: 14px; color: var(--ink-soft); margin: 6px 0 0; }

  /* === CARDS === */
  .card { background: var(--surface); border: 0.5px solid var(--line); border-radius: 14px; padding: 20px; margin-bottom: 16px; box-shadow: var(--shadow-sm); }
  .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; flex-wrap: wrap; gap: 8px; }
  .card-title { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 500; margin: 0; color: var(--ink); letter-spacing: -0.01em; }
  .card-subtitle { font-size: 12px; color: var(--ink-muted); margin: 4px 0 0; }
  .badge { font-size: 10px; padding: 3px 9px; border-radius: 12px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
  .badge-live { background: var(--green-bg); color: var(--green-ink); }
  .badge-sov { background: var(--amber-bg); color: var(--amber-ink); }
  .badge-new { background: var(--purple-bg); color: var(--purple-ink); }
  .badge-beta { background: var(--blue-bg); color: var(--blue-ink); }

  /* === STAT GRID === */
  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px; }
  .stat-card { background: var(--surface); border: 0.5px solid var(--line); border-radius: 12px; padding: 16px; box-shadow: var(--shadow-sm); }
  .stat-label { font-size: 10px; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }
  .stat-value { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 500; color: var(--navy-900); margin-top: 4px; letter-spacing: -0.02em; }
  .stat-delta { font-size: 11px; color: var(--green-ink); margin-top: 4px; font-weight: 500; }
  .stat-delta.neutral { color: var(--ink-muted); }

  /* === ROLE SELECTOR MODAL === */
  .modal-overlay { position: fixed; inset: 0; background: rgba(10, 37, 64, 0.7); backdrop-filter: blur(8px); z-index: 1000; display: none; align-items: center; justify-content: center; padding: 24px; }
  .modal-overlay.active { display: flex; animation: fadeIn 0.2s ease; }
  .modal { background: var(--surface); border-radius: 20px; max-width: 600px; width: 100%; padding: 32px; box-shadow: 0 20px 60px rgba(10, 37, 64, 0.25); max-height: 85vh; overflow-y: auto; }
  .modal-header { margin-bottom: 20px; text-align: center; }
  .modal-eyebrow { font-family: 'Fraunces', serif; font-size: 11px; letter-spacing: 0.25em; color: var(--gold-500); margin-bottom: 8px; font-weight: 500; }
  .modal-title { font-family: 'Fraunces', serif; font-size: 24px; font-weight: 500; color: var(--ink); margin: 0; letter-spacing: -0.01em; }
  .modal-sub { font-size: 13px; color: var(--ink-soft); margin: 8px 0 0; }
  .role-options { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 8px; }
  .role-option { padding: 14px 16px; border: 0.5px solid var(--line); border-radius: 12px; cursor: pointer; transition: all 0.15s; background: var(--surface-2); }
  .role-option:hover { border-color: var(--gold-500); background: var(--gold-50); transform: translateY(-1px); }
  .role-option-name { font-size: 13px; font-weight: 600; color: var(--navy-900); margin-bottom: 2px; }
  .role-option-org { font-size: 11px; color: var(--ink-muted); margin-bottom: 6px; }
  .role-option-perms { font-size: 10px; color: var(--ink-soft); font-family: 'JetBrains Mono', monospace; }

  /* === DASHBOARD QUICK ACTIONS === */
  .quick-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; }
  .qa-card { background: var(--surface); border: 0.5px solid var(--line); border-radius: 12px; padding: 18px; cursor: pointer; transition: all 0.15s; }
  .qa-card:hover { border-color: var(--gold-500); transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .qa-icon { width: 40px; height: 40px; border-radius: 10px; background: var(--gold-50); color: var(--navy-900); display: flex; align-items: center; justify-content: center; font-family: 'Fraunces', serif; font-size: 18px; margin-bottom: 12px; font-weight: 500; border: 0.5px solid var(--gold-500); }
  .qa-title { font-size: 14px; font-weight: 600; color: var(--ink); margin: 0 0 4px; }
  .qa-desc { font-size: 12px; color: var(--ink-muted); margin: 0; line-height: 1.5; }

  /* === NOTIFICATIONS PANEL === */
  .notif-panel { position: fixed; top: 60px; right: 28px; width: 380px; background: var(--surface); border: 0.5px solid var(--line-strong); border-radius: 14px; box-shadow: var(--shadow-lg); z-index: 100; display: none; max-height: 480px; overflow: hidden; flex-direction: column; }
  .notif-panel.active { display: flex; }
  .notif-header { padding: 14px 18px; border-bottom: 0.5px solid var(--line); display: flex; justify-content: space-between; align-items: center; }
  .notif-title { font-family: 'Fraunces', serif; font-size: 15px; font-weight: 500; color: var(--ink); margin: 0; }
  .notif-mark-read { font-size: 11px; color: var(--ink-muted); cursor: pointer; }
  .notif-mark-read:hover { color: var(--navy-900); text-decoration: underline; }
  .notif-list { overflow-y: auto; flex: 1; }
  .notif-item { padding: 12px 18px; border-bottom: 0.5px dashed var(--line); cursor: pointer; transition: background 0.15s; }
  .notif-item:hover { background: var(--surface-2); }
  .notif-item.unread { background: var(--gold-50); }
  .notif-item.unread::before { content: ""; display: inline-block; width: 6px; height: 6px; background: var(--gold-500); border-radius: 50%; margin-right: 8px; vertical-align: middle; }
  .notif-msg { font-size: 12px; color: var(--ink); line-height: 1.5; margin: 0; }
  .notif-meta { font-size: 10px; color: var(--ink-muted); margin-top: 4px; font-family: 'JetBrains Mono', monospace; }

  /* === SEARCH RESULTS === */
  .search-wrap { display: flex; gap: 10px; margin-bottom: 14px; }
  .search-input { flex: 1; padding: 11px 14px; border: 0.5px solid var(--line-strong); border-radius: 10px; font-size: 13px; font-family: inherit; background: var(--surface-2); color: var(--ink); }
  .search-input:focus { outline: none; border-color: var(--gold-500); box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15); background: var(--surface); }
  .btn-primary { background: var(--navy-900); color: var(--gold-100); border: none; padding: 11px 22px; border-radius: 10px; font-size: 13px; cursor: pointer; font-weight: 600; font-family: inherit; transition: all 0.15s; }
  .btn-primary:hover { background: var(--navy-800); }
  .btn-secondary { background: var(--surface); color: var(--ink-soft); border: 0.5px solid var(--line-strong); padding: 9px 14px; border-radius: 8px; font-size: 12px; cursor: pointer; font-family: inherit; font-weight: 500; transition: all 0.15s; }
  .btn-secondary:hover { background: var(--surface-2); color: var(--ink); }

  .filter-chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; align-items: center; }
  .chip-label { font-size: 11px; color: var(--ink-muted); font-weight: 500; margin-right: 4px; }
  .chip { background: var(--surface-2); border: 0.5px solid var(--line); padding: 5px 11px; border-radius: 14px; font-size: 11px; cursor: pointer; transition: all 0.15s; color: var(--ink-soft); font-weight: 500; }
  .chip:hover { background: var(--gold-50); border-color: var(--gold-500); color: var(--ink); }
  .chip.active { background: var(--navy-900); color: var(--gold-100); border-color: var(--navy-900); }

  .pill { background: var(--surface-2); border: 0.5px solid var(--line); padding: 5px 11px; border-radius: 14px; font-size: 11px; cursor: pointer; transition: all 0.15s; color: var(--ink-soft); display: inline-block; margin: 2px; font-weight: 500; }
  .pill:hover { background: var(--gold-50); border-color: var(--gold-500); }

  .result-meta-bar { display: flex; justify-content: space-between; font-size: 11px; color: var(--ink-muted); padding: 9px 14px; background: var(--surface-2); border-radius: 8px; margin-bottom: 12px; font-family: 'JetBrains Mono', monospace; flex-wrap: wrap; gap: 6px; }
  .result-item { background: var(--surface-2); border-radius: 10px; padding: 14px 16px; margin-bottom: 8px; border-left: 3px solid var(--gold-500); transition: all 0.15s; }
  .result-item:hover { background: var(--gold-50); transform: translateX(2px); }
  .result-meta { display: flex; gap: 8px; align-items: center; font-size: 11px; color: var(--ink-muted); margin-bottom: 6px; flex-wrap: wrap; }
  .result-code { font-weight: 700; color: var(--navy-900); font-family: 'JetBrains Mono', monospace; }
  .result-score { background: var(--gold-500); color: #422510; font-size: 10px; padding: 2px 8px; border-radius: 10px; font-weight: 700; margin-left: auto; font-family: 'JetBrains Mono', monospace; }
  .result-title { font-size: 13px; font-weight: 600; color: var(--ink); margin: 0 0 6px; }
  .result-snippet { font-size: 12px; color: var(--ink-soft); margin: 0; line-height: 1.6; }
  .result-actions { display: flex; gap: 6px; margin-top: 8px; }
  .result-action { font-size: 11px; padding: 4px 10px; border-radius: 6px; background: var(--surface); border: 0.5px solid var(--line); cursor: pointer; color: var(--ink-soft); font-weight: 500; }
  .result-action:hover { background: var(--gold-50); border-color: var(--gold-500); color: var(--ink); }

  .status-pill { padding: 2px 7px; border-radius: 10px; font-size: 10px; font-weight: 600; }
  .status-berlaku { background: var(--green-bg); color: var(--green-ink); }
  .status-sebagian { background: var(--amber-bg); color: var(--amber-ink); }

  /* === C4R === */
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
  textarea.search-input { width: 100%; resize: vertical; min-height: 90px; line-height: 1.6; font-family: inherit; }
  .c4r-grid { display: grid; grid-template-columns: 130px 1fr; gap: 12px 16px; margin-top: 14px; }
  .c4r-label { font-size: 11px; font-weight: 700; color: var(--navy-900); text-transform: uppercase; letter-spacing: 0.08em; padding-top: 10px; font-family: 'JetBrains Mono', monospace; }
  .c4r-value { font-size: 12px; color: var(--ink); padding: 11px 14px; background: var(--surface-2); border-left: 3px solid var(--gold-500); border-radius: 0 8px 8px 0; line-height: 1.65; }

  /* === TABLES === */
  table.data-table { width: 100%; font-size: 13px; border-collapse: collapse; }
  .data-table th { text-align: left; padding: 9px 11px; font-weight: 600; font-size: 10px; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 0.5px solid var(--line); background: var(--surface-2); }
  .data-table td { padding: 11px; border-bottom: 0.5px solid var(--line); }
  .data-table tr:last-child td { border-bottom: none; }
  .data-table tr:hover td { background: var(--surface-2); }

  .routed-local { background: var(--green-bg); color: var(--green-ink); padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 600; font-family: 'JetBrains Mono', monospace; }
  .sens-pill { padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 600; }
  .sens-public { background: var(--blue-bg); color: var(--blue-ink); }
  .sens-internal { background: var(--amber-bg); color: var(--amber-ink); }
  .sens-confidential { background: var(--orange-bg); color: var(--orange-ink); }
  .sens-restricted { background: var(--red-bg); color: var(--red-ink); }

  /* === CHARTS === */
  .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px; }
  .chart-canvas-wrap { position: relative; height: 220px; }

  /* === WORKSPACE === */
  .workspace-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .ws-item { padding: 12px 14px; background: var(--surface-2); border-radius: 10px; border-left: 3px solid var(--gold-500); margin-bottom: 8px; cursor: pointer; transition: all 0.15s; }
  .ws-item:hover { background: var(--gold-50); }
  .ws-item-title { font-size: 13px; font-weight: 600; color: var(--ink); margin: 0 0 4px; }
  .ws-item-meta { font-size: 11px; color: var(--ink-muted); font-family: 'JetBrains Mono', monospace; }

  /* === RISK REGISTER === */
  .risk-row { display: grid; grid-template-columns: 1fr auto auto auto; gap: 12px; padding: 12px 14px; background: var(--surface-2); border-radius: 10px; margin-bottom: 8px; align-items: center; border-left: 3px solid var(--amber); }
  .risk-row.high { border-left-color: var(--red); }
  .risk-row.low { border-left-color: var(--green); }
  .risk-title { font-size: 13px; font-weight: 600; color: var(--ink); }
  .risk-meta { font-size: 11px; color: var(--ink-muted); font-family: 'JetBrains Mono', monospace; }
  .risk-level { font-size: 10px; padding: 3px 8px; border-radius: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .risk-level.high { background: var(--red-bg); color: var(--red-ink); }
  .risk-level.medium { background: var(--amber-bg); color: var(--amber-ink); }
  .risk-level.low { background: var(--green-bg); color: var(--green-ink); }

  /* === LOADING === */
  .loading { padding: 18px; color: var(--ink-muted); font-size: 13px; text-align: center; font-style: italic; }
  .loading::before { content: ""; display: inline-block; width: 12px; height: 12px; margin-right: 10px; border: 2px solid var(--gold-500); border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; vertical-align: middle; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .empty-state { text-align: center; padding: 40px 20px; color: var(--ink-muted); font-size: 13px; }
  .empty-state-icon { font-family: 'Fraunces', serif; font-size: 32px; color: var(--gold-500); opacity: 0.5; margin-bottom: 12px; }

  /* === KNOWLEDGE BASE === */
  .kb-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .kb-card { padding: 16px; background: var(--surface-2); border-radius: 10px; border: 0.5px solid var(--line); cursor: pointer; transition: all 0.15s; }
  .kb-card:hover { border-color: var(--gold-500); background: var(--gold-50); }
  .kb-cat { font-size: 9px; color: var(--gold-500); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 6px; font-family: 'JetBrains Mono', monospace; }
  .kb-title { font-size: 13px; font-weight: 600; color: var(--ink); margin: 0 0 6px; line-height: 1.4; }
  .kb-snippet { font-size: 11px; color: var(--ink-muted); line-height: 1.5; }

  /* === GAUGE === */
  .gauge-wrap { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .gauge-info h3 { font-family: 'Fraunces', serif; font-size: 16px; margin: 0 0 6px; font-weight: 500; }
  .gauge-info p { font-size: 12px; color: var(--ink-soft); margin: 0 0 12px; line-height: 1.6; max-width: 480px; }
  .gauge-breakdown { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; font-size: 11px; max-width: 380px; }
  .gauge-stat-label { color: var(--ink-muted); }
  .gauge-stat-value { font-weight: 600; color: var(--ink); margin-left: 4px; font-family: 'JetBrains Mono', monospace; }

  /* === MOBILE === */
  @media (max-width: 768px) {
    .app-layout { grid-template-columns: 1fr; }
    .sidebar { display: none; }
    .stats-row, .quick-actions, .charts-grid, .workspace-grid, .kb-grid, .role-options, .form-grid { grid-template-columns: 1fr; }
    .topbar-search { max-width: none; }
    .content-wrap { padding: 16px; }
    .notif-panel { width: calc(100vw - 24px); right: 12px; }
  }

  /* Print */
  @media print {
    .sidebar, .topbar, .notif-panel, .modal-overlay { display: none !important; }
    .app-layout { grid-template-columns: 1fr; }
    .card, .stat-card { box-shadow: none; border: 0.5px solid #ccc; page-break-inside: avoid; }
  }
</style>
</head>
<body>

<!-- ROLE SELECTOR MODAL -->
<div class="modal-overlay" id="role-modal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-eyebrow">⚜ DEMO ROLE SELECTOR ⚜</div>
      <h2 class="modal-title">Pilih role untuk explore platform</h2>
      <p class="modal-sub">Demo mode — tampilan dashboard, navigation, dan permissions akan disesuaikan dengan role yang dipilih. Pada production: role auto-detect dari email <code>@bpkh.go.id</code>. Struktur sesuai <strong>UU 34/2014</strong> & bpkh.go.id (Two-board system: Dewan Pengawas + Badan Pelaksana).</p>
    </div>
    <div class="role-options">
      <div class="role-option" onclick="selectRole('dewas')">
        <div class="role-option-name">Anggota Dewan Pengawas</div>
        <div class="role-option-org">Dewan Pengawas BPKH · 7 anggota</div>
        <div class="role-option-perms">Executive Dashboard · Sovereignty · Risk Overview · Reports</div>
      </div>
      <div class="role-option" onclick="selectRole('komite-audit')">
        <div class="role-option-name">Anggota Komite Audit</div>
        <div class="role-option-org">Komite Audit (support Dewas) · ~5 anggota</div>
        <div class="role-option-perms">DALIL · DAWWIN · Audit Log · Findings</div>
      </div>
      <div class="role-option" onclick="selectRole('badan-pelaksana')">
        <div class="role-option-name">Anggota Badan Pelaksana</div>
        <div class="role-option-org">Badan Pelaksana BPKH · 7 anggota</div>
        <div class="role-option-perms">Decision Dashboard · Approval · Investment Tracker</div>
      </div>
      <div class="role-option" onclick="selectRole('kedeputian')">
        <div class="role-option-name">Kedeputian</div>
        <div class="role-option-org">Pegawai Kedeputian (Investasi · Operasional · Keuangan)</div>
        <div class="role-option-perms">Compliance Pre-check · DALIL · Workflow</div>
      </div>
      <div class="role-option" onclick="selectRole('auditor')">
        <div class="role-option-name">Auditor Internal (SPI)</div>
        <div class="role-option-org">Satuan Pengawasan Internal · ~30 user</div>
        <div class="role-option-perms">Risk Register · Findings · DAWWIN</div>
      </div>
      <div class="role-option" onclick="selectRole('insan-bpkh')">
        <div class="role-option-name">Insan BPKH</div>
        <div class="role-option-org">Pegawai general · ~190 user</div>
        <div class="role-option-perms">Search · Knowledge Base · FAQ · Notifications</div>
      </div>
    </div>
  </div>
</div>

<!-- NOTIFICATION PANEL -->
<div class="notif-panel" id="notif-panel">
  <div class="notif-header">
    <h3 class="notif-title">Notifications</h3>
    <span class="notif-mark-read" onclick="markAllRead()">Mark all as read</span>
  </div>
  <div class="notif-list" id="notif-list"></div>
</div>

<!-- MAIN APP LAYOUT -->
<div class="app-layout">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-crest">⚜ BPKH SOVEREIGN AI</div>
      <div class="brand-name">MONI</div>
      <div class="brand-sub">Internal Platform v3.1</div>
    </div>

    <div class="role-switcher" onclick="openRoleModal()">
      <div class="role-label">Active role</div>
      <div class="role-name">
        <span id="active-role-name">Loading...</span>
        <span class="role-name-arrow">▾</span>
      </div>
      <div class="role-org" id="active-role-org">—</div>
    </div>

    <nav id="nav-menu">
      <!-- Populated dynamically based on role -->
    </nav>

    <div class="sidebar-footer">
      <div class="user-card">
        <div class="user-avatar" id="user-avatar">SH</div>
        <div class="user-info">
          <div class="user-name" id="user-fullname">Sopian Hadianto</div>
          <div class="user-email" id="user-email">sopian@bpkh.go.id</div>
        </div>
      </div>
    </div>
  </aside>

  <!-- MAIN AREA -->
  <main class="main-area">

    <!-- TOPBAR -->
    <div class="topbar">
      <div class="topbar-search">
        <span class="topbar-search-icon">⌕</span>
        <input type="text" placeholder="Search regulasi, workpaper, atau ask MONI..." id="global-search" onkeydown="if(event.key==='Enter') globalSearch()" />
      </div>
      <div class="topbar-actions">
        <button class="topbar-btn notif-bell" onclick="toggleNotif()">
          <span style="font-family:'Fraunces',serif;font-size:14px;">◔</span>
          <span class="notif-dot" id="notif-dot"></span>
        </button>
        <button class="topbar-btn" onclick="window.print()">⎙ Print</button>
        <button class="topbar-btn primary" onclick="openRoleModal()">↻ Switch role</button>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="content-wrap">

      <!-- DASHBOARD PAGE -->
      <div id="page-dashboard" class="page active">
        <div class="page-header">
          <div class="page-eyebrow" id="dash-eyebrow">⌗ DASHBOARD</div>
          <h1 class="page-title" id="dash-title">Selamat datang, Sopian</h1>
          <p class="page-sub" id="dash-sub">Sovereign AI platform untuk pengelolaan dana haji Rp 179+ triliun</p>
        </div>

        <div class="stats-row" id="dashboard-stats"></div>

        <div class="card">
          <div class="card-header">
            <div><h2 class="card-title">Quick actions</h2><p class="card-subtitle">Berdasarkan role Anda</p></div>
          </div>
          <div class="quick-actions" id="quick-actions"></div>
        </div>

        <div class="charts-grid">
          <div class="card">
            <div class="card-header"><div><h2 class="card-title">Activity 7 hari terakhir</h2><p class="card-subtitle">Tools usage by service</p></div></div>
            <div class="chart-canvas-wrap"><canvas id="chart-activity"></canvas></div>
          </div>
          <div class="card">
            <div class="card-header"><div><h2 class="card-title">Sovereignty score</h2><p class="card-subtitle">100% local inference verified</p></div></div>
            <div class="gauge-wrap" style="padding:8px 0;">
              <svg width="140" height="140" viewBox="0 0 140 140">
                <circle cx="70" cy="70" r="56" fill="none" stroke="#E5E7EB" stroke-width="11" />
                <circle cx="70" cy="70" r="56" fill="none" stroke="#16A34A" stroke-width="11" stroke-dasharray="352" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(-90 70 70)" />
                <text x="70" y="68" text-anchor="middle" font-family="Fraunces,serif" font-size="28" font-weight="500" fill="#0A2540">100%</text>
                <text x="70" y="86" text-anchor="middle" font-family="Manrope,sans-serif" font-size="9" font-weight="600" fill="#6B7280" letter-spacing="2">SOVEREIGN</text>
              </svg>
              <div class="gauge-info">
                <h3>All inference local</h3>
                <p>Zero data exfiltration · Cryptographic SHA-256 chain · ISO 37002 audit trail.</p>
                <div class="gauge-breakdown">
                  <div><span class="gauge-stat-label">Today:</span><span class="gauge-stat-value" id="today-inferences">—</span></div>
                  <div><span class="gauge-stat-label">7 days:</span><span class="gauge-stat-value" id="week-inferences">—</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><div><h2 class="card-title">Recent activity</h2><p class="card-subtitle">Anda dan team</p></div></div>
          <div id="recent-activity"></div>
        </div>
      </div>

      <!-- DALIL PAGE -->
      <div id="page-dalil" class="page">
        <div class="page-header">
          <div class="page-eyebrow">⌗ DALIL · دليل</div>
          <h1 class="page-title">Regulatory Intelligence</h1>
          <p class="page-sub">Semantic search 220 regulasi BPKH · PBPKH · PKBP · SOP · KEP · Surat Edaran</p>
        </div>

        <div class="card">
          <div class="card-header">
            <div><h2 class="card-title">Search</h2><p class="card-subtitle">Powered by nomic-embed-text · 100% local</p></div>
            <span class="badge badge-sov">100% LOCAL</span>
          </div>
          <div class="search-wrap">
            <input type="text" class="search-input" id="dalil-query" placeholder='Coba: "kewajiban audit eksternal"' value="kewajiban audit eksternal" onkeydown="if(event.key==='Enter') runDalilSearch()" />
            <button class="btn-primary" onclick="runDalilSearch()">Cari</button>
            <button class="btn-secondary" onclick="saveSearch()">⊕ Save</button>
          </div>
          <div class="filter-chips">
            <span class="chip-label">FILTER:</span>
            <span class="chip active" onclick="setFilter(this,'all')">Semua</span>
            <span class="chip" onclick="setFilter(this,'PBPKH')">PBPKH</span>
            <span class="chip" onclick="setFilter(this,'PKBP')">PKBP</span>
            <span class="chip" onclick="setFilter(this,'SOP')">SOP</span>
            <span class="chip" onclick="setFilter(this,'KEP')">KEP</span>
          </div>
          <div style="margin-bottom:14px;">
            <span class="pill" onclick="setQuery('penempatan dana haji syariah')">penempatan dana haji syariah</span>
            <span class="pill" onclick="setQuery('mekanisme pengelolaan kemaslahatan')">pengelolaan kemaslahatan</span>
            <span class="pill" onclick="setQuery('pelaporan keuangan haji')">pelaporan keuangan</span>
            <span class="pill" onclick="setQuery('whistleblowing')">WBS</span>
            <span class="pill" onclick="setQuery('komite investasi')">komite investasi</span>
            <span class="pill" onclick="setQuery('audit internal independen')">audit internal</span>
            <span class="pill" onclick="setQuery('sukuk negara')">sukuk negara</span>
          </div>
          <div id="dalil-results"></div>
        </div>
      </div>

      <!-- DAWWIN PAGE -->
      <div id="page-dawwin" class="page">
        <div class="page-header">
          <div class="page-eyebrow">⌗ DAWWIN · دوّن</div>
          <h1 class="page-title">Audit Workpaper Generator</h1>
          <p class="page-sub">C4R methodology · Condition · Criteria · Cause · Consequence · Recommendation</p>
        </div>
        <div class="card">
          <div class="card-header">
            <div><h2 class="card-title">Generate workpaper</h2><p class="card-subtitle">AI-assisted · llama3.1:8b sovereign</p></div>
            <span class="badge badge-sov">SOVEREIGN AI</span>
          </div>
          <div class="form-grid">
            <input type="text" class="search-input" id="eng-code" value="ENG-2026-Q1-INV" placeholder="Engagement code" />
            <input type="text" class="search-input" id="wp-ref" value="WP-2026-Q1-001" placeholder="WP reference" />
          </div>
          <textarea class="search-input" id="findings-input" placeholder="Raw findings dari audit fieldwork...">Ditemukan 12 transaksi penempatan dana haji ke deposito syariah senilai Rp 600 miliar pada Q1 2026 tanpa persetujuan formal Komite Investasi sebagaimana diatur PBPKH 2/2025 Pasal 14.</textarea>
          <div style="display:flex;gap:8px;margin-top:12px;">
            <button class="btn-primary" onclick="generateC4R()">Generate C4R</button>
            <button class="btn-secondary" onclick="saveDraft()">⊕ Save draft</button>
          </div>
          <div id="c4r-output"></div>
        </div>
      </div>

      <!-- WORKSPACE PAGE -->
      <div id="page-workspace" class="page">
        <div class="page-header">
          <div class="page-eyebrow">⌗ WORKSPACE</div>
          <h1 class="page-title">Personal workspace</h1>
          <p class="page-sub">Saved searches, drafts, dan history Anda</p>
        </div>
        <div class="workspace-grid">
          <div class="card">
            <div class="card-header"><div><h2 class="card-title">Saved searches</h2><p class="card-subtitle">Quick access ke query Anda</p></div></div>
            <div id="saved-searches"></div>
          </div>
          <div class="card">
            <div class="card-header"><div><h2 class="card-title">Drafts</h2><p class="card-subtitle">Workpaper draft yang belum final</p></div></div>
            <div id="drafts-list"></div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><div><h2 class="card-title">Activity history</h2><p class="card-subtitle">Aktivitas Anda di MONI platform</p></div></div>
          <div id="user-activity"></div>
        </div>
      </div>

      <!-- RISK REGISTER PAGE -->
      <div id="page-risk" class="page">
        <div class="page-header">
          <div class="page-eyebrow">⌗ RISK REGISTER</div>
          <h1 class="page-title">Risk register & findings</h1>
          <p class="page-sub">Track temuan audit + risk assessment + remediation status</p>
        </div>
        <div class="stats-row">
          <div class="stat-card"><div class="stat-label">Open findings</div><div class="stat-value">23</div><div class="stat-delta neutral">5 high · 12 medium · 6 low</div></div>
          <div class="stat-card"><div class="stat-label">In remediation</div><div class="stat-value">14</div><div class="stat-delta">+3 this week</div></div>
          <div class="stat-card"><div class="stat-label">Closed (Q1)</div><div class="stat-value">47</div><div class="stat-delta">96% on-time</div></div>
          <div class="stat-card"><div class="stat-label">Avg resolution</div><div class="stat-value">21d</div><div class="stat-delta">-4d vs Q4</div></div>
        </div>
        <div class="card">
          <div class="card-header"><div><h2 class="card-title">Active risks</h2><p class="card-subtitle">Sorted by severity</p></div><button class="btn-primary" style="font-size:11px;padding:7px 14px;">+ Add finding</button></div>
          <div id="risk-list"></div>
        </div>
      </div>

      <!-- COMPLIANCE CHECK PAGE (Investasi role) -->
      <div id="page-compliance" class="page">
        <div class="page-header">
          <div class="page-eyebrow">⌗ COMPLIANCE CHECK</div>
          <h1 class="page-title">Pre-execution validator</h1>
          <p class="page-sub">Validasi compliance sebelum eksekusi transaksi · Real-time check terhadap PBPKH/PKBP/SOP</p>
        </div>
        <div class="card">
          <div class="card-header"><div><h2 class="card-title">Transaction validator</h2><p class="card-subtitle">Input detail transaksi → AI check terhadap regulasi yang berlaku</p></div><span class="badge badge-new">NEW</span></div>
          <div class="form-grid">
            <select class="search-input" id="txn-type">
              <option>Penempatan deposito syariah</option>
              <option>Pembelian sukuk negara</option>
              <option>Penyaluran kemaslahatan</option>
              <option>Investasi langsung</option>
            </select>
            <input type="text" class="search-input" id="txn-amount" placeholder="Nominal (juta Rupiah)" value="600000" />
          </div>
          <div class="form-grid">
            <input type="text" class="search-input" id="txn-counterparty" placeholder="Counterparty" value="Bank Syariah Mandiri" />
            <input type="text" class="search-input" id="txn-date" placeholder="Tanggal eksekusi" value="2026-04-30" />
          </div>
          <button class="btn-primary" onclick="runComplianceCheck()" style="margin-top:12px;">Run compliance check</button>
          <div id="compliance-result"></div>
        </div>
      </div>

      <!-- KNOWLEDGE BASE PAGE -->
      <div id="page-kb" class="page">
        <div class="page-header">
          <div class="page-eyebrow">⌗ KNOWLEDGE BASE</div>
          <h1 class="page-title">Knowledge base & FAQ</h1>
          <p class="page-sub">Best practices · Training materials · FAQ untuk seluruh insan BPKH</p>
        </div>
        <div class="card">
          <div class="card-header"><div><h2 class="card-title">Browse by topic</h2><p class="card-subtitle">12 kategori · 87 articles</p></div></div>
          <div class="kb-grid">
            <div class="kb-card" onclick="openKB('investasi')"><div class="kb-cat">⊞ INVESTASI</div><div class="kb-title">Mekanisme penempatan dana haji</div><div class="kb-snippet">Panduan lengkap workflow approval, threshold validation, dan dokumentasi mandatory.</div></div>
            <div class="kb-card" onclick="openKB('audit')"><div class="kb-cat">⊞ AUDIT</div><div class="kb-title">Methodology C4R untuk workpaper</div><div class="kb-snippet">Cara menggunakan Condition-Criteria-Cause-Consequence-Recommendation framework.</div></div>
            <div class="kb-card" onclick="openKB('wbs')"><div class="kb-cat">⊞ WBS</div><div class="kb-title">Whistleblowing reporting guide</div><div class="kb-snippet">Cara melaporkan dugaan pelanggaran sesuai ISO 37002 dengan PII protection.</div></div>
            <div class="kb-card" onclick="openKB('compliance')"><div class="kb-cat">⊞ COMPLIANCE</div><div class="kb-title">PBPKH 2/2025 simplified guide</div><div class="kb-snippet">Highlights penting dari PBPKH 2/2025 yang harus dipahami semua insan BPKH.</div></div>
            <div class="kb-card" onclick="openKB('kemaslahatan')"><div class="kb-cat">⊞ KEMASLAHATAN</div><div class="kb-title">Penyaluran dana kemaslahatan umat</div><div class="kb-snippet">Mekanisme, threshold, dan dokumentasi penyaluran maksimal 10% dari nilai manfaat.</div></div>
            <div class="kb-card" onclick="openKB('reporting')"><div class="kb-cat">⊞ REPORTING</div><div class="kb-title">Standar pelaporan keuangan haji</div><div class="kb-snippet">PSAK Syariah implementation guide untuk laporan tahunan dana haji.</div></div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><div><h2 class="card-title">FAQ — Top questions</h2><p class="card-subtitle">Berdasarkan query terbanyak insan BPKH</p></div></div>
          <div id="faq-list"></div>
        </div>
      </div>

      <!-- AUDIT LOG PAGE -->
      <div id="page-audit" class="page">
        <div class="page-header">
          <div class="page-eyebrow">⌗ SOVEREIGNTY &amp; AUDIT</div>
          <h1 class="page-title">Audit log & sovereignty</h1>
          <p class="page-sub">Cryptographic proof bahwa semua AI inference routed lokal · ISO 37002 compliant</p>
        </div>
        <div class="charts-grid">
          <div class="card">
            <div class="card-header"><div><h2 class="card-title">Sovereignty trend (24h)</h2><p class="card-subtitle">Local vs cloud routing</p></div></div>
            <div class="chart-canvas-wrap"><canvas id="chart-sovereignty"></canvas></div>
          </div>
          <div class="card">
            <div class="card-header"><div><h2 class="card-title">Activity by service</h2><p class="card-subtitle">Distribution across modules</p></div></div>
            <div class="chart-canvas-wrap"><canvas id="chart-services"></canvas></div>
          </div>
        </div>
        <div class="card">
          <div class="card-header">
            <div><h2 class="card-title">Audit log entries</h2><p class="card-subtitle">Immutable · SHA-256 chain · Schema-per-service di Postgres</p></div>
            <div style="display:flex;gap:6px;">
              <button class="btn-secondary" onclick="seedDemoData()">⚡ Seed</button>
              <button class="btn-secondary" onclick="exportAudit()">↓ Export</button>
              <button class="btn-secondary" onclick="clearAuditLog()">⊘ Clear</button>
            </div>
          </div>
          <div id="audit-table-wrap"></div>
        </div>
      </div>

      <!-- ADMIN PAGE -->
      <div id="page-admin" class="page">
        <div class="page-header">
          <div class="page-eyebrow">⌗ ADMIN</div>
          <h1 class="page-title">Platform administration</h1>
          <p class="page-sub">User management · Role assignment · Configuration</p>
        </div>
        <div class="stats-row">
          <div class="stat-card"><div class="stat-label">Total users</div><div class="stat-value">247</div><div class="stat-delta">+18 this month</div></div>
          <div class="stat-card"><div class="stat-label">Active today</div><div class="stat-value">89</div><div class="stat-delta neutral">36% of users</div></div>
          <div class="stat-card"><div class="stat-label">Roles configured</div><div class="stat-value">6</div><div class="stat-delta neutral">Full coverage</div></div>
          <div class="stat-card"><div class="stat-label">Storage used</div><div class="stat-value">12GB</div><div class="stat-delta neutral">of 100GB</div></div>
        </div>
        <div class="card">
          <div class="card-header"><div><h2 class="card-title">User directory</h2><p class="card-subtitle">All authenticated users dengan @bpkh.go.id</p></div></div>
          <div id="user-directory"></div>
        </div>
      </div>

    </div>
  </main>
</div>

<script>
// =================================================================
